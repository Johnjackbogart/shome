# Copy to apps/web/.env (Next.js loads env from the app directory, not the
# monorepo root) and adjust. Without DATABASE_URL the server uses an embedded
# PGlite database in apps/web/.data/pglite — zero setup, good for local hacking.
# DATABASE_URL=postgres://shome:shome@localhost:5432/shome

# Secret for Better Auth session/token signing — generate with: openssl rand -hex 32
# (a throwaway value is fine for local dev; required in production)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Key for encrypting stored platform credentials at rest (AES-256-GCM via HKDF).
# Falls back to BETTER_AUTH_SECRET when unset; set a dedicated value in
# production so the auth and storage keys can rotate independently.
# CREDENTIALS_ENCRYPTION_KEY=

# Fallback API key for the YouTube connector when a user has not linked
# their own key as a connection.
# YOUTUBE_API_KEY=

# Server-only key for generating an editable portfolio draft in the My page tab.
# Create one in the OpenAI API dashboard; never expose it with a NEXT_PUBLIC_ prefix.
# OPENAI_API_KEY=
# Optional: defaults to gpt-5.6-terra, which balances quality and cost for this task.
# OPENAI_PORTFOLIO_MODEL=gpt-5.6-terra
